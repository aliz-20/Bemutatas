g === 'en') {\n      btnEn.style.background = 'rgba(125, 249, 255, 0.2)';\n      btnEn.style.color = '#7DF9FF';\n      btnHu.style.background = 'transparent';\n      btnHu.style.color = 'rgba(255, 255, 255, 0.4)';\n    } else {\n      btnHu.style.background = 'rgba(125, 249, 255, 0.2)';\n      btnHu.style.color = '#7DF9FF';\n      btnEn.style.background = 'transparent';\n      btnEn.style.color = 'rgba(255, 255, 255, 0.4)';\n    }\n  }\n</script>\n",
