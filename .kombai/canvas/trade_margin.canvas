      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Archivo:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\n\n  body {\n    background-color: #010B13;\n    color: #ffffff;\n    font-family: 'Archivo', sans-serif;\n    overflow-x: hidden;\n  }\n\n  .font-sora { font-family: 'Sora', sans-serif; }\n  .font-archivo { font-family: 'Archivo', sans-serif; }\n\n  /* Glassmorphism utility */\n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  /* Neon accents */\n  .text-neon-aqua { color: #7DF9FF; }\n  .bg-neon-aqua { background-color: #7DF9FF; }\n  .border-neon-aqua { border-color: #7DF9FF; }\n  .shadow-neon-aqua { shadow: 0 0 15px rgba(125, 249, 255, 0.3); }\n\n  .text-neon-violet { color: #DF00FF; }\n  .bg-neon-violet { background-color: #DF00FF; }\n  .border-neon-violet { border-color: #DF00FF; }\n\n  /* Custom animations */\n  @keyframes orb-float {\n    0%, 100% { transform: translate(0, 0); }\n    50% { transform: translate(30px, -30px); }\n  }\n  .animate-orb { animation: orb-float 8s ease-in-out infinite; }\n\n  /* Hide scrollbar but keep functionality */\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n</style>\n\n<div class=\"relative\" data-kid=\"1\">\n  \n  \n  <header class=\"absolute top-6 left-1/2 -translate-x-1/2 z-[100] w-[95%] max-w-[1200px]\" data-kid=\"2\">\n    <div class=\"glass px-8 py-4 rounded-full flex items-center justify-between shadow-2xl\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-gradient-to-br from-[#7DF9FF] to-[#DF00FF] rounded-xl flex items-center justify-center rotate-3\" data-kid=\"5\">\n          <i class=\"fa-solid fa-bolt text-black text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"font-sora font-extrabold text-xl tracking-tighter uppercase\" data-kid=\"7\">Trade Margin</span>\n      </div>\n      \n      <nav class=\"hidden md:flex items-center gap-10\" data-kid=\"8\">\n        <a href=\"#home\" class=\"text-sm font-semibold hover:text-[#7DF9FF] transition-colors uppercase tracking-widest\" data-en=\"Home\" data-hu=\"Főoldal\" data-kid=\"9\">Home</a>\n        <a href=\"#about\" class=\"text-sm font-semibold hover:text-[#7DF9FF] transition-colors uppercase tracking-widest\" data-en=\"About\" data-hu=\"Rólunk\" data-kid=\"10\">About</a>\n        <a href=\"#products\" class=\"text-sm font-semibold hover:text-[#7DF9FF] transition-colors uppercase tracking-widest\" data-en=\"Inventory\" data-hu=\"Készlet\" data-kid=\"11\">Inventory</a>\n        <a href=\"#contact\" class=\"text-sm font-semibold hover:text-[#7DF9FF] transition-colors uppercase tracking-widest\" data-en=\"Contact\" data-hu=\"Kapcsolat\" data-kid=\"12\">Contact</a>\n      </nav>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"13\">\n        <div class=\"flex bg-white/5 rounded-full p-1 border border-white/10\" data-kid=\"14\">\n          <button onclick=\"setLang('en')\" id=\"btn-en\" class=\"px-3 py-1 text-[10px] font-bold rounded-full transition-all active-lang\" style=\"background: rgba(125, 249, 255, 0.2); color: #7DF9FF;\" data-kid=\"15\">EN</button>\n          <button onclick=\"setLang('hu')\" id=\"btn-hu\" class=\"px-3 py-1 text-[10px] font-bold rounded-full transition-all text-white/40\" data-kid=\"16\">HU</button>\n        </div>\n        <a href=\"#contact\" class=\"hidden lg:block bg-[#7DF9FF] text-black px-6 py-2.5 rounded-full text-xs font-black uppercase tracking-widest hover:scale-105 transition-transform\" data-kid=\"17\">Get Quotes</a>\n      </div>\n    </div>\n  </header>\n\n  \n  <section id=\"home\" class=\"relative min-h-[950px] flex items-center pt-48 pb-20 overflow-hidden\" data-kid=\"18\">\n    \n    <div class=\"absolute inset-0 z-0\" data-kid=\"19\">\n      <div class=\"absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-[#7DF9FF]/15 blur-[120px] rounded-full animate-orb\" data-kid=\"20\"></div>\n      <div class=\"absolute bottom-1/4 right-1/4 w-[700px] h-[700px] bg-[#DF00FF]/15 blur-[150px] rounded-full animate-orb\" style=\"animation-delay: -4s;\" data-kid=\"21\"></div>\n    </div>\n\n    \n    <div class=\"absolute inset-0 z-0 opacity-40\" data-kid=\"22\">\n      <img src=\"https://images.unsplash.com/photo-1690029670784-155329105e58?auto=format&fit=crop&w=1920&q=80\" alt=\"Sleek Phone Edge\" class=\"w-full h-full object-cover mix-blend-screen\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n    </div>\n\n    <div class=\"container mx-auto px-6 relative z-10\" data-kid=\"24\">\n      <div class=\"max-w-[1000px] mx-auto text-center\" data-kid=\"25\">\n        <span class=\"inline-block px-4 py-1 rounded-full bg-white/5 border border-white/10 text-[#7DF9FF] text-[10px] font-bold uppercase tracking-[0.4em] mb-8\" data-en=\"Direct B2B Wholesale Europe\" data-hu=\"Közvetlen B2B Nagykereskedelem Európa\" data-kid=\"26\">Direct B2B Wholesale Europe</span>\n        <h1 class=\"font-sora text-6xl md:text-9xl font-extrabold tracking-tighter leading-[0.85] uppercase mb-12\" data-kid=\"27\">\n          Smart Phones.<br data-kid=\"28\">\n          <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#7DF9FF] to-[#DF00FF]\" data-kid=\"29\">Smart Deals.</span><br data-kid=\"30\">\n          Smarter Trading.\n        </h1>\n        \n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"31\">\n          <button class=\"group relative px-12 py-5 bg-[#7DF9FF] text-black rounded-2xl font-sora font-black uppercase tracking-widest overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_60px_rgba(125,249,255,0.5)] cursor-pointer\" data-kid=\"32\">\n            <span class=\"relative z-10\" data-en=\"Secure Inventory Access\" data-hu=\"Készlet Hozzáférés\" data-kid=\"33\">Secure Inventory Access</span>\n          </button>\n          <div class=\"flex items-center gap-4 px-6 py-4 glass rounded-2xl border-white/10\" data-kid=\"34\">\n            <div class=\"flex -space-x-2\" data-kid=\"35\">\n              <div class=\"w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center\" data-kid=\"36\"><i class=\"fa-brands fa-apple text-xs\" data-kid=\"37\"></i></div>\n              <div class=\"w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center\" data-kid=\"38\"><i class=\"fa-solid fa-mobile text-xs\" data-kid=\"39\"></i></div>\n            </div>\n            <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-60\" data-kid=\"40\">Verified Partners</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute top-[25%] left-[8%] rotate-[-12deg] hidden xl:block transform perspective-1000 rotate-y-[15deg]\" data-kid=\"41\">\n        <div class=\"glass p-5 rounded-2xl w-52 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border-white/20\" data-kid=\"42\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"43\">\n            <i class=\"fa-brands fa-apple text-2xl\" data-kid=\"44\"></i>\n            <span class=\"text-[10px] font-bold text-[#7DF9FF]\" data-kid=\"45\">STOCK: ACTIVE</span>\n          </div>\n          <div class=\"text-lg font-bold font-sora mb-1\" data-kid=\"46\">iPhone 15 Pro</div>\n          <div class=\"text-2xl font-black text-white/90\" data-kid=\"47\">€ 914<span class=\"text-sm font-normal opacity-50\" data-kid=\"48\">.00</span></div>\n          <div class=\"mt-4 h-1 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"49\">\n            <div class=\"h-full bg-neon-aqua w-[85%]\" data-kid=\"50\"></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"absolute bottom-[25%] right-[8%] rotate-[8deg] hidden xl:block transform perspective-1000 rotate-y-[-15deg]\" data-kid=\"51\">\n        <div class=\"glass p-5 rounded-2xl w-60 shadow-[0_20px_50px_rgba(0,0,0,0.5)] border-white/20\" data-kid=\"52\">\n          <div class=\"flex items-center gap-3 mb-4\" data-kid=\"53\">\n            <div class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" data-kid=\"54\"></div>\n            <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-60\" data-kid=\"55\">Global Sourcing Live</span>\n          </div>\n          <div class=\"flex items-end gap-2 mb-4\" data-kid=\"56\">\n             <div class=\"w-8 h-12 bg-white/10 rounded-sm\" data-kid=\"57\"></div>\n             <div class=\"w-8 h-16 bg-[#7DF9FF]/30 rounded-sm\" data-kid=\"58\"></div>\n             <div class=\"w-8 h-10 bg-white/10 rounded-sm\" data-kid=\"59\"></div>\n             <div class=\"w-8 h-20 bg-[#DF00FF]/40 rounded-sm\" data-kid=\"60\"></div>\n             <div class=\"w-8 h-14 bg-white/10 rounded-sm\" data-kid=\"61\"></div>\n          </div>\n          <div class=\"text-xs font-bold opacity-40\" data-kid=\"62\">Price trend: Bullish (+2.4%)</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"py-32 relative\" data-kid=\"63\">\n    <div class=\"container mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-0\" data-kid=\"64\">\n      \n      <div class=\"lg:col-span-2 relative hidden lg:block\" data-kid=\"65\">\n        <div class=\"absolute top-20 left-0\" data-kid=\"66\">\n          <span class=\"text-[#7DF9FF] font-sora font-black text-7xl opacity-5 uppercase vertical-rl tracking-[0.3em] select-none whitespace-nowrap block\" style=\"writing-mode: vertical-rl; transform: rotate(180deg);\" data-kid=\"67\">\n            Underground Sourcing\n          </span>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-6 lg:pl-12 flex flex-col justify-center\" data-kid=\"68\">\n        <div class=\"mb-12\" data-kid=\"69\">\n          <h2 class=\"font-sora text-5xl md:text-7xl font-extrabold uppercase leading-none mb-8\" data-en=\"About Trade Margin\" data-hu=\"A Trade Marginről\" data-kid=\"70\">About Trade Margin</h2>\n          <p class=\"text-xl text-white/70 font-light leading-relaxed max-w-[540px] mb-10\" data-en=\"We are a dynamically developing mobile phone wholesale business supplying European resellers with premium-quality devices. We make phone trading easier, cleaner and more accessible.\" data-hu=\"Dinamikusan fejlődő mobiltelefon-nagykereskedelmi vállalkozás vagyunk, amely európai viszonteladókat lát el prémium készülékekkel. A kereskedelmet átláthatóbbá és hozzáférhetőbbé tesszük.\" data-kid=\"71\">\n            We are a dynamically developing mobile phone wholesale business supplying European resellers with premium-quality devices. We make phone trading easier, cleaner and more accessible.\n          </p>\n          <div class=\"grid grid-cols-2 gap-8 border-t border-white/10 pt-10\" data-kid=\"72\">\n            <div data-kid=\"73\">\n              <div class=\"text-3xl font-sora font-bold text-[#7DF9FF] mb-2\" data-kid=\"74\">24h</div>\n              <div class=\"text-xs uppercase tracking-widest opacity-50\" data-en=\"Quotation turnaround\" data-hu=\"Ajánlattételi idő\" data-kid=\"75\">Quotation turnaround</div>\n            </div>\n            <div data-kid=\"76\">\n              <div class=\"text-3xl font-sora font-bold text-[#DF00FF] mb-2\" data-kid=\"77\">100%</div>\n              <div class=\"text-xs uppercase tracking-widest opacity-50\" data-en=\"Checked inventory\" data-hu=\"Ellenőrzött készlet\" data-kid=\"78\">Checked inventory</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-4 lg:absolute lg:right-0 lg:h-full lg:w-[30%] hidden lg:block\" data-kid=\"79\">\n        <img src=\"https://images.unsplash.com/photo-1645782054550-f7ee24753e34?auto=format&fit=crop&w=1200&q=80\" alt=\"Stacked Phones\" class=\"w-full h-full object-cover grayscale brightness-50 hover:grayscale-0 hover:brightness-100 transition-all duration-1000\" decoding=\"async\" loading=\"lazy\" data-kid=\"80\">\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"products\" class=\"py-32 bg-[#003153]/20 relative\" data-kid=\"81\">\n    <div class=\"container mx-auto px-6\" data-kid=\"82\">\n      <div class=\"flex flex-col md:flex-row items-end justify-between mb-20 gap-8\" data-kid=\"83\">\n        <div class=\"max-w-[600px]\" data-kid=\"84\">\n          <span class=\"text-[#7DF9FF] font-bold text-xs uppercase tracking-[0.4em] block mb-4\" data-en=\"Live Inventory\" data-hu=\"Aktuális Készlet\" data-kid=\"85\">Live Inventory</span>\n          <h2 class=\"font-sora text-5xl md:text-6xl font-extrabold uppercase leading-tight\" data-en=\"Direct Category Access\" data-hu=\"Közvetlen Kategóriák\" data-kid=\"86\">Direct Category Access</h2>\n        </div>\n        <p class=\"text-white/50 text-right max-w-[300px] hidden md:block\" data-en=\"Sourced from verified European logistics hubs.\" data-hu=\"Ellenőrzött európai logisztikai központokból származó készlet.\" data-kid=\"87\">Sourced from verified European logistics hubs.</p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-4 grid-rows-auto gap-6\" data-kid=\"88\">\n        \n        <div class=\"md:col-span-2 md:row-span-2 glass rounded-[2rem] p-10 relative overflow-hidden group hover:border-[#7DF9FF]/50 hover:shadow-[0_0_50px_rgba(125,249,255,0.05)] transition-all duration-500\" data-kid=\"89\">\n          <div class=\"relative z-10 h-full flex flex-col justify-between\" data-kid=\"90\">\n            <div data-kid=\"91\">\n              <div class=\"w-14 h-14 rounded-2xl bg-white/5 flex items-center justify-center mb-8\" data-kid=\"92\">\n                <i class=\"fa-brands fa-apple text-3xl\" data-kid=\"93\"></i>\n              </div>\n              <h3 class=\"text-3xl font-sora font-bold mb-4\" data-kid=\"94\">Apple iPhone</h3>\n              <p class=\"text-white/60 max-w-[280px]\" data-kid=\"95\">New, CPO, and high-grade refurbished devices available with European warranty.</p>\n            </div>\n            <div class=\"flex gap-4\" data-kid=\"96\">\n              <span class=\"px-3 py-1 bg-white/5 rounded-full text-[10px] font-bold\" data-kid=\"97\">14 SERIES</span>\n              <span class=\"px-3 py-1 bg-[#7DF9FF]/20 text-[#7DF9FF] rounded-full text-[10px] font-bold\" data-kid=\"98\">15 PRO / MAX</span>\n              <span class=\"px-3 py-1 bg-white/5 rounded-full text-[10px] font-bold\" data-kid=\"99\">SE 2022</span>\n            </div>\n          </div>\n          <div class=\"absolute -right-20 -bottom-20 w-3/4 opacity-40 group-hover:scale-105 group-hover:opacity-80 transition-all duration-700 pointer-events-none\" data-kid=\"100\">\n            <img src=\"https://images.unsplash.com/photo-1703756883520-0569b33605b7?auto=format&fit=crop&w=1000&q=85\" alt=\"iPhone\" class=\"w-full h-full object-contain\" decoding=\"async\" loading=\"lazy\" data-kid=\"101\">\n          </div>\n        </div>\n\n        \n        <div class=\"md:col-span-2 glass rounded-[2rem] p-10 relative overflow-hidden group hover:border-[#7DF9FF]/50 transition-all duration-500 flex items-center justify-between\" data-kid=\"102\">\n          <div class=\"relative z-10\" data-kid=\"103\">\n            <h3 class=\"text-2xl font-sora font-bold mb-2\" data-kid=\"104\">Samsung Galaxy</h3>\n            <p class=\"text-white/60 text-sm max-w-[200px]\" data-kid=\"105\">Enterprise-grade S-series & Foldables.</p>\n          </div>\n          <div class=\"w-40 h-40 opacity-10 group-hover:opacity-30 transition-opacity\" data-kid=\"106\">\n            <i class=\"fa-solid fa-mobile-screen text-[120px] text-white\" data-kid=\"107\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"glass rounded-[2rem] p-8 group hover:border-[#7DF9F